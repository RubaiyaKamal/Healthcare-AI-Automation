# ============================================================
# HAPI FHIR sandbox (local) — do NOT depend on hapi.fhir.org
# ============================================================
FHIR_BASE_URL=http://localhost:8080/fhir

# ============================================================
# PostgreSQL (app-db) — cache / state / audit
# ============================================================
DATABASE_URL=postgresql://app_user:app_password@localhost:5434/healthcare_ai

# FHIR's own db (used by hapi inside docker-compose)
FHIR_DB_URL=postgresql://hapi:hapi_123@localhost:5433/hapi

# ============================================================
# OpenAI Agents SDK
# ============================================================
OPENAI_API_KEY=sk-your-key-here
# Warning: intake_agent sends patient data to OpenAI. For a real
# HIPAA deployment use an Azure OpenAI endpoint with a BAA.